# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file. Everything here is optional: the app runs without any of it.

# Optional AI mode for CV reading (off unless set to 1). Without it, CVs are read by rules.
BRIDGE_CV_AI=0
# Model for AI mode (default claude-opus-5-5)
BRIDGE_AI_MODEL=claude-opus-5-5
# On Replit, the Anthropic AI integration sets AI_INTEGRATIONS_ANTHROPIC_API_KEY and
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL for you. Anywhere else, use your own key:
ANTHROPIC_API_KEY=your-anthropic-api-key
