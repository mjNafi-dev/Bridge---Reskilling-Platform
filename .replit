modules = ["python-3.11", "nodejs-20"]
run = "bash scripts/start.sh"

[nix]
channel = "stable-24_05"

[deployment]
build = ["bash", "scripts/build.sh"]
run = ["bash", "-c", "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

[[ports]]
localPort = 8000
externalPort = 80
